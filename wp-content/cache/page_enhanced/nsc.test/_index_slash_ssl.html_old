                                            <div id="nscCookieBar" class="nsc-cookie-bar" role="dialog" aria-live="polite" aria-label="Cookie preferences">
      <div class="nsc-cookie-bar__inner">
        <div class="nsc-cookie-bar__text">
          <div class="nsc-cookie-bar__copy">
            <h3>We use cookies</h3>
            <p>This site uses cookies to improve your browsing experience, analyze traffic, and remember your preferences. You can accept all cookies, reject non-essential cookies, or review details in our Cookies Policy.</p>
          </div>
          <div class="nsc-cookie-bar__actions">
            <button type="button" class="nsc-cookie-bar__btn" data-cookie-action="reject">Reject non-essential</button>
            <a href="https://nsc.test/cookies-policy/" class="nsc-cookie-bar__btn nsc-cookie-bar__btn--ghost" data-cookie-action="settings">Cookie settings</a>
            <button type="button" class="nsc-cookie-bar__btn" data-cookie-action="accept">Accept all</button>
          </div>
        </div>
      </div>
    </div>
    <style>
      .nsc-cookie-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 99999;
        background: var(--color-primary, #36c3dc);
        color: #fff;
        box-shadow: 0 -6px 18px rgba(0, 0, 0, 0.16);
        padding: 14px 18px;
      }
      .nsc-cookie-bar.is-hidden {
        display: none;
      }
      .nsc-cookie-bar__inner {
        max-width: 1280px;
        margin: 0 auto;
      }
      .nsc-cookie-bar__text {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .nsc-cookie-bar__copy h3 {
        margin: 0;
        color: #fff;
        font-size: 17px;
        line-height: 1.2;
        font-weight: 700;
        flex: 0 0 auto;
      }
      .nsc-cookie-bar__copy p {
        margin: 0;
        color: #fff;
        font-size: 14px;
        line-height: 1.45;
        font-weight: 500;
        flex: 1 1 auto;
      }
      .nsc-cookie-bar__actions {
        display: flex;
        gap: 8px;
        flex: 0 0 auto;
      }
      .nsc-cookie-bar__btn {
        border: 1px solid #fff;
        background: #fff;
        color: var(--color-primary, #36c3dc);
        font-weight: 700;
        font-size: 13px;
        line-height: 1;
        padding: 10px 12px;
        text-decoration: none;
        cursor: pointer;
      }
      .nsc-cookie-bar__btn--ghost {
        background: transparent;
        color: #fff;
      }
      @media (max-width: 767px) {
        .nsc-cookie-bar {
          padding: 12px;
        }
        .nsc-cookie-bar__text {
          display: block;
        }
        .nsc-cookie-bar__copy h3 {
          margin-bottom: 6px;
          font-size: 16px;
        }
        .nsc-cookie-bar__copy p {
          margin-bottom: 8px;
          font-size: 13px;
        }
        .nsc-cookie-bar__actions {
          flex-wrap: wrap;
        }
      }
    </style>
    <script>
      (function () {
        var KEY = "nsc_cookie_consent_v1";
        var root = document.getElementById("nscCookieBar");
        if (!root) return;

        try {
          var saved = window.localStorage.getItem(KEY);
          if (saved) {
            root.classList.add("is-hidden");
          }
        } catch (e) {}

        function saveConsent(mode) {
          try {
            window.localStorage.setItem(KEY, mode);
          } catch (e) {}
          root.classList.add("is-hidden");
        }

        root.addEventListener("click", function (e) {
          var trigger = e.target.closest("[data-cookie-action]");
          if (!trigger) return;
          var action = trigger.getAttribute("data-cookie-action");
          if (action === "accept") {
            e.preventDefault();
            saveConsent("accept_all");
          } else if (action === "reject") {
            e.preventDefault();
            saveConsent("reject_non_essential");
          }
        });
      })();
    </script>
