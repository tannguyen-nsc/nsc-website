{% extends 'templates/_document.twig' %}

{% block content %}
  <article>
    <header>
      <h1>{{ post.title|e }}</h1>
      {% if post.date %}<time datetime="{{ post.date('c') }}">{{ post.date }}</time>{% endif %}
    </header>
    <section class="wp-block-post-content">
      {{ post.content }}
    </section>
  </article>
{% endblock %}
