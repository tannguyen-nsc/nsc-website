{% extends 'templates/_document.twig' %}

{% block content %}
  {% set js = job_single|default({}) %}
  {% set post_title_plain = function('html_entity_decode', post.title|default('')) %}
  {% set why_title = (js.jobSidebarWhyUsTitle|default(''))|trim ?: __('Why us?', 'NscSoftware') %}
  {% set share_title = (js.jobSidebarShareTitle|default(''))|trim ?: __('Share this vacancy', 'NscSoftware') %}
  {% set apply_heading = (js.jobApplyHeading|default(''))|trim ?: __('Apply now', 'NscSoftware') %}
  {% set key_technologies_label = (js.jobKeyTechnologiesLabel|default(''))|trim ?: __('Key technologies', 'NscSoftware') %}
  {% set why_items = js.jobSidebarWhyUsItems|default([]) %}

  <section class="career-details" aria-label="{{ __('Job opening', 'NscSoftware')|e }}">
    <div class="career-details__shell">
      <div class="wrapper career-details__shell-inner">
        <nav class="career-details__breadcrumbs" aria-label="{{ __('Breadcrumb', 'NscSoftware')|e }}">
          <a href="{{ career_archive_url|e('esc_url') }}">{{ __('Career', 'NscSoftware')|e }}</a>
          <span class="career-details__bc-sep" aria-hidden="true">&gt;</span>
          <span class="career-details__bc-current">{{ post_title_plain|e }}</span>
        </nav>

        <div class="career-details__card">
          <div class="career-details__grid">
            <div class="career-details__main">
              <h1 class="career-details__title">{{ post_title_plain|e }}</h1>

              {% if job_tags is iterable and job_tags|length > 0 %}
                <div class="career-details__tags">
                  {% for tag in job_tags %}
                    <span class="career-details__tag">{{ tag.name|e }}</span>
                  {% endfor %}
                </div>
              {% endif %}

              <a href="#career-apply" class="career-details__apply-cta">{{ __('Apply now', 'NscSoftware')|e }} <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>

              {% if job_skills is iterable and job_skills|length > 0 %}
                <h2 class="career-details__h2">{{ __('Required skills', 'NscSoftware')|e }}</h2>
                <ul class="career-details__skills">
                  {% for skill in job_skills %}
                    <li class="career-details__skill career-details__skill--process">
                      <p class="career-details__skill-label">{{ skill.title|e }}</p>
                      <div class="career-details__skill-bar" aria-hidden="true">
                        {% if skill.filled == skill.total %}
                          {% for i in 1..skill.total %}
                            <span class="career-details__skill-bar-segment"></span>
                          {% endfor %}
                        {% else %}
                          {% for i in 1..skill.total %}
                            <span class="career-details__skill-bar-segment{% if i > skill.filled %} skill--none{% endif %}"></span>
                          {% endfor %}
                        {% endif %}
                      </div>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}

              <div class="career-details__body">
                {% if post.content %}
                  {{ post.content }}
                {% endif %}

                {% if job_content_blocks is iterable and job_content_blocks|length > 0 %}
                  {% for block in job_content_blocks %}
                    {% if block.title|default('') %}
                      <h2 class="career-details__h2">{{ block.title|e }}</h2>
                    {% endif %}
                    {% if block.content|default('') %}
                      {{ block.content|raw }}
                    {% endif %}
                  {% endfor %}
                {% endif %}

                {% if job_key_technology_names is iterable and job_key_technology_names|length > 0 %}
                  <p>{{ key_technologies_label|e }}: {{ job_key_technology_names|join(', ')|e }}</p>
                {% endif %}
              </div>
            </div>

            <aside class="career-details__sidebar" aria-label="{{ __('Role highlights', 'NscSoftware')|e }}">
              {% if why_items is iterable and why_items|length > 0 %}
                <div class="career-details__side-block">
                  <h2 class="career-details__side-title">{{ why_title|e }}</h2>
                  <ul class="career-details__side-list">
                    {% for row in why_items %}
                      {% if row.line|default('') %}
                        <li>{{ row.line|e }}</li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}

              <div class="career-details__side-block">
                <h2 class="career-details__side-title">{{ share_title|e }}</h2>
                <div class="career-details__share-icons">
                  <a href="#" class="blog-details__share-btn" data-blog-share="facebook" aria-label="{{ __('Share on Facebook', 'NscSoftware')|e }}" target="_blank" rel="noopener noreferrer">
                    <svg width="24" height="24" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M19.5 10.5C19.5 9.70435 19.8163 8.94151 20.3789 8.37891C20.9415 7.8163 21.7043 7.5 22.5 7.5H25.5V4.5H22.5C20.9087 4.5 19.383 5.13259 18.2578 6.25781C17.1326 7.38303 16.5 8.9087 16.5 10.5V15C16.5 15.8284 15.8284 16.5 15 16.5H12V19.5H15C15.8284 19.5 16.5 20.1716 16.5 21V31.5H19.5V21C19.5 20.1716 20.1716 19.5 21 19.5H24.3296L25.0796 16.5H21C20.1716 16.5 19.5 15.8284 19.5 15V10.5ZM22.5 13.5H27C27.4619 13.5 27.8979 13.7131 28.1821 14.0771C28.4663 14.4411 28.5665 14.9153 28.4546 15.3633L26.9546 21.3633C26.7877 22.031 26.1883 22.5 25.5 22.5H22.5V33C22.5 33.8284 21.8284 34.5 21 34.5H15C14.1716 34.5 13.5 33.8284 13.5 33V22.5H10.5C9.67157 22.5 9 21.8284 9 21V15C9 14.1716 9.67157 13.5 10.5 13.5H13.5V10.5C13.5 8.11305 14.4489 5.82455 16.1367 4.13672C17.8245 2.44889 20.1131 1.5 22.5 1.5H27C27.8284 1.5 28.5 2.17157 28.5 3V9C28.5 9.82843 27.8284 10.5 27 10.5H22.5V13.5Z" fill="currentColor"/>
                    </svg>
                  </a>
                  <a href="#" class="blog-details__share-btn" data-blog-share="linkedin" aria-label="{{ __('Share on LinkedIn', 'NscSoftware')|e }}" target="_blank" rel="noopener noreferrer">
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M9 12C9.82843 12 10.5 12.6716 10.5 13.5V31.5C10.5 32.3284 9.82843 33 9 33H3C2.17157 33 1.5 32.3284 1.5 31.5V13.5C1.5 12.6716 2.17157 12 3 12H9ZM31.5 21C31.5 19.0109 30.7093 17.1038 29.3027 15.6973C27.8962 14.2907 25.9891 13.5 24 13.5C22.0109 13.5 20.1038 14.2907 18.6973 15.6973C17.2907 17.1038 16.5 19.0109 16.5 21V30H19.5V21C19.5 19.8065 19.9744 18.6623 20.8184 17.8184C21.6623 16.9744 22.8065 16.5 24 16.5C25.1935 16.5 26.3377 16.9744 27.1816 17.8184C28.0256 18.6623 28.5 19.8065 28.5 21V30H31.5V21ZM4.5 30H7.5V15H4.5V30ZM7.5 6C7.5 5.17157 6.82843 4.5 6 4.5C5.17157 4.5 4.5 5.17157 4.5 6C4.5 6.82843 5.17157 7.5 6 7.5C6.82843 7.5 7.5 6.82843 7.5 6ZM34.5 31.5C34.5 32.3284 33.8284 33 33 33H27C26.1716 33 25.5 32.3284 25.5 31.5V21C25.5 20.6022 25.3419 20.2208 25.0605 19.9395C24.7792 19.6581 24.3978 19.5 24 19.5C23.6022 19.5 23.2208 19.6581 22.9395 19.9395C22.6581 20.2208 22.5 20.6022 22.5 21V31.5C22.5 32.3284 21.8284 33 21 33H15C14.1716 33 13.5 32.3284 13.5 31.5V21C13.5 18.2152 14.6056 15.5438 16.5747 13.5747C18.5438 11.6056 21.2152 10.5 24 10.5C26.7848 10.5 29.4562 11.6056 31.4253 13.5747C33.3944 15.5438 34.5 18.2152 34.5 21V31.5ZM10.5 6C10.5 8.48528 8.48528 10.5 6 10.5C3.51472 10.5 1.5 8.48528 1.5 6C1.5 3.51472 3.51472 1.5 6 1.5C8.48528 1.5 10.5 3.51472 10.5 6Z" fill="currentColor"/>
                    </svg>
                  </a>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="career-details__apply" id="career-apply" aria-labelledby="career-apply-heading">
    <div class="career-details__apply-inner">
      <div class="wrapper career-details__apply-wrapper">
        <div class="heading light" id="career-apply-heading">
          {% if theme.buildUri %}
            <img src="{{ theme.buildUri|e('esc_url') }}/img/heading-icon.webp" alt="" loading="lazy" />
          {% endif %}
          <h2>{{ apply_heading|e }}</h2>
        </div>

        {% if apply_form_html %}
          {# CF7: career-details__apply-form is added to <form> via wpcf7_form_class_attr (see nscJobApplyCf7.php). Styles here override CF7 default CSS load disabled on job singles. #}
          <div class="career-details__apply-form--cf7 wpcf7-wrapper">
          <style>
            .career-details__apply-form--cf7 .hidden-fields-container {
              display: none !important;
            }
            .career-details__apply-form--cf7 .career-details__consent .wpcf7-form-control-wrap {
              width: auto !important;
            }
            .career-details__consent input {
              margin-top: 0 !important;
            }
            .career-details__submit svg {
              width: 1.5rem !important;
              height: 1.5rem !important;
            }
           
          </style>
            {{ apply_form_html|raw }}
          </div>
        {% else %}
          <p class="career-details__apply-placeholder text-center text-sm text-neutral-600">
            {{ __('Run create-nsc-cf7-form.php with apply_only=1, or paste a Contact Form 7 shortcode under NSC Theme Options → Careers.', 'NscSoftware')|e }}
          </p>
        {% endif %}
      </div>
    </div>
  </section>
{% endblock %}
