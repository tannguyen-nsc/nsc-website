<!DOCTYPE html>
<html class="html {{ body_class }}" {{ site.language_attributes }}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="alternate" type="application/rss+xml" title="{{- theme.labels.feed|replace({ '%s': site.title }) -}}" href="{{ site.rss2|e('esc_url') }}">
    {{ function('wp_head') }}
  </head>
  <body>
    {{ function('wp_body_open') }}
    {% block layout %}
      <div class="pageWrapper">
        {% block header %}
          {{ renderComponent('NSCHeader') }}
        {% endblock %}
        <main id="mainContent" class="mainContent" aria-label="{{- theme.labels.mainContentAriaLabel|e -}}">
          {% if function('post_password_required') %}
            {{ function('get_the_password_form') }}
          {% else %}
            {% block content %}
              No <code>{{ '{% block content %}' }}</code> defined for this template.
            {% endblock %}
          {% endif %}
        </main>
        {% block footer %}
          {{ renderComponent('NSCFooter') }}
        {% endblock %}
      </div>
    {% endblock %}
    {% set cookieContent = cookie_content|default({}) %}
    {% set cookieAriaLabel = cookieContent.ariaLabel|default(__('Cookie preferences', 'NscSoftware')) %}
    {% set cookieHeading = cookieContent.heading|default(__('We use cookies', 'NscSoftware')) %}
    {% set cookieDescription = cookieContent.content|default(__('This site uses cookies to improve your browsing experience, analyze traffic, and remember your preferences. You can accept all cookies, reject non-essential cookies, or review details in our Cookies Policy.', 'NscSoftware')) %}
    {% set cookieRejectLabel = cookieContent.rejectLabel|default(__('Reject non-essential', 'NscSoftware')) %}
    {% set cookieSettingsLabel = cookieContent.settingsLabel|default(__('Cookie settings', 'NscSoftware')) %}
    {% set cookieAcceptLabel = cookieContent.acceptLabel|default(__('Accept all', 'NscSoftware')) %}
    {% set cookiesPolicyUrl = cookieContent.settingsUrl|default(function('nsc_resolve_page_permalink', 'cookies-policy'))|default(function('home_url', '/cookies-policy/')) %}
    {% set cookieSettingsNewTab = cookieContent.settingsOpenInNewTab|default(false) %}
    <div id="nscCookieBar" class="nsc-cookie-bar" role="dialog" aria-live="polite" aria-label="{{ cookieAriaLabel|e }}">
      <div class="nsc-cookie-bar__inner">
        <div class="nsc-cookie-bar__text">
          <div class="nsc-cookie-bar__copy">
            <h3>{{ cookieHeading|e }}</h3>
            <p>{{ cookieDescription|e }}</p>
          </div>
          <div class="nsc-cookie-bar__actions">
            <button type="button" class="nsc-cookie-bar__btn" data-cookie-action="reject">{{ cookieRejectLabel|e }}</button>
            <a href="{{ cookiesPolicyUrl|e('esc_url') }}" class="nsc-cookie-bar__btn nsc-cookie-bar__btn--ghost" data-cookie-action="settings"{% if cookieSettingsNewTab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ cookieSettingsLabel|e }}</a>
            <button type="button" class="nsc-cookie-bar__btn" data-cookie-action="accept">{{ cookieAcceptLabel|e }}</button>
          </div>
        </div>
      </div>
    </div>
    <style>
      .nsc-cookie-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 99999;
        background: var(--color-primary, #36c3dc);
        color: #fff;
        box-shadow: 0 -6px 18px rgba(0, 0, 0, 0.16);
        padding: 14px 18px;
      }
      .nsc-cookie-bar.is-hidden {
        display: none;
      }
      .nsc-cookie-bar__inner {
        max-width: 1280px;
        margin: 0 auto;
      }
      .nsc-cookie-bar__text {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .nsc-cookie-bar__copy h3 {
        margin: 0;
        color: #fff;
        font-size: 17px;
        line-height: 1.2;
        font-weight: 700;
        flex: 0 0 auto;
      }
      .nsc-cookie-bar__copy p {
        margin: 0;
        color: #fff;
        font-size: 14px;
        line-height: 1.45;
        font-weight: 500;
        flex: 1 1 auto;
      }
      .nsc-cookie-bar__actions {
        display: flex;
        gap: 8px;
        flex: 0 0 auto;
      }
      .nsc-cookie-bar__btn {
        border: 1px solid #fff;
        background: #fff;
        color: var(--color-primary, #36c3dc);
        font-weight: 700;
        font-size: 13px;
        line-height: 1;
        padding: 10px 12px;
        text-decoration: none;
        cursor: pointer;
      }
      .nsc-cookie-bar__btn--ghost {
        background: transparent;
        color: #fff;
      }
      @media (max-width: 767px) {
        .nsc-cookie-bar {
          padding: 12px;
        }
        .nsc-cookie-bar__text {
          display: block;
        }
        .nsc-cookie-bar__copy h3 {
          margin-bottom: 6px;
          font-size: 16px;
        }
        .nsc-cookie-bar__copy p {
          margin-bottom: 8px;
          font-size: 13px;
        }
        .nsc-cookie-bar__actions {
          flex-wrap: wrap;
        }
      }
    </style>
    <script>
      (function () {
        var KEY = "nsc_cookie_consent_v1";
        var root = document.getElementById("nscCookieBar");
        if (!root) return;

        try {
          var saved = window.localStorage.getItem(KEY);
          if (saved) {
            root.classList.add("is-hidden");
          }
        } catch (e) {}

        function saveConsent(mode) {
          try {
            window.localStorage.setItem(KEY, mode);
          } catch (e) {}
          root.classList.add("is-hidden");
        }

        root.addEventListener("click", function (e) {
          var trigger = e.target.closest("[data-cookie-action]");
          if (!trigger) return;
          var action = trigger.getAttribute("data-cookie-action");
          if (action === "accept") {
            e.preventDefault();
            saveConsent("accept_all");
          } else if (action === "reject") {
            e.preventDefault();
            saveConsent("reject_non_essential");
          }
        });
      })();
    </script>
    <div class="wpFooter">
      {{ function('wp_footer') }}
    </div>
  </body>
</html>
