{% if not (options.hidden|default(0)) %}
<nsc-software-component name="NSCBlockStats">
  <section class="stats">
  <div class="wrapper">
    {% if imageDesktop.url or imageDesktop.src %}
      <img src="{{ (imageDesktop.url|default(imageDesktop.src))|e('esc_url') }}" alt="{{ (imageDesktop.alt|default(''))|e }}" class="lg:block hidden" loading="lazy" />
    {% elseif theme.buildUri %}
      <img src="{{ theme.buildUri }}/img/company-stats.png" alt="Company Stats" class="lg:block hidden" loading="lazy" />
    {% endif %}
    {% if imageMobile.url or imageMobile.src %}
      <img src="{{ (imageMobile.url|default(imageMobile.src))|e('esc_url') }}" alt="{{ (imageMobile.alt|default(''))|e }}" class="lg:hidden" loading="lazy" />
    {% elseif theme.buildUri %}
      <img src="{{ theme.buildUri }}/img/company-stats-mob.png" alt="Company Stats" class="lg:hidden" loading="lazy" />
    {% endif %}
    <div class="company-stats">
      {% for stat in stats %}
        <div class="stat animate__animated animate__flipInY">
          <h2><span class="count">{{ stat.number|e }}</span>{{ stat.suffix|e }}</h2>
          <h3>{{ stat.title|e }}</h3>
          {% if stat.subtitle %}<p>{{ stat.subtitle|e }}</p>{% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
  </section>
</nsc-software-component>
{% endif %}
