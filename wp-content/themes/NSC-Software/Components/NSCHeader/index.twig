<nsc-software-component name="NSCHeader">
  
  {# Mobile Header (shows for mobile up to xl) #}
  
  <header class="mobile-header {% if headerClass %}{{ headerClass|e }}{% endif %} xl:hidden">
    <div class="mobile-header-wrapper">
      <div class="mobile-logo-wrapper">
        <a href="{{ site.link|e('esc_url') }}">
          <img src="{{ (mobileLogo.white.src|default(mobileLogo.white.url)|default(buildUri ~ '/img/mob-logo-white.webp'))|e('esc_url') }}" class="mobile-logo-white" alt="{{ (mobileLogo.white.alt|default(''))|e }}" loading="eager" fetchpriority="low" />
          <img src="{{ (mobileLogo.colored.src|default(mobileLogo.colored.url)|default(buildUri ~ '/img/mob-logo.webp'))|e('esc_url') }}" class="mobile-logo-colored" alt="{{ (mobileLogo.colored.alt|default(''))|e }}" loading="eager" fetchpriority="low" />
        </a>
      </div>
      <div class="mobile-center">
        <span class="mobile-home-text">{{ labels.mobileHomeText|default('Home')|e }}</span>
      </div>
      <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="{{ labels.ariaLabel|e }}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 12H21M3 6H21M3 18H21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    <div class="mobile-nav" id="mobileNav">
      <span>{{ mobileNavMenuLabel|default('Menu')|e }}</span>
      <button class="mobile-nav-close" id="mobileNavClose" aria-label="{{ labels.closeMenu|default('Close menu')|e }}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      {% if menu %}
      <ul class="mobile-nav-list">
        {% for item in menu.items %}
          {% set _item_class = (item.classes|default([])|join(' '))|trim %}
          {% if item.children %}
            {% set _parent_toggle_only = 'no-link-cursor' in (item.classes|default([])) %}
            <li class="mobile-dropdown-parent{{ not _parent_toggle_only ? ' mobile-about-dropdown' }}">
              {% if _parent_toggle_only %}
              <a class="mobile-nav-link mobile-dropdown-toggle no-link-cursor {{ item.current_ancestor ? 'active' : '' }} {{ _item_class }}">
                {{ item.title|e }}
                <svg class="mobile-nav-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              {% else %}
              <div class="mobile-nav-dropdown-row">
                <a href="{{ item.link|e('esc_url') }}" class="mobile-nav-link mobile-nav-link--about-label {{ item.current or item.current_ancestor ? 'active' : '' }} {{ _item_class }}"{{ item.is_target_blank ? ' target="_blank" rel="noopener noreferrer"' }}>
                  {{ item.title|e }}
                </a>
                <button type="button" class="mobile-dropdown-toggle mobile-dropdown-toggle--chevron" aria-expanded="false" aria-label="{{ (labels.expandSubmenu|default('Expand submenu'))|e('html_attr') }}: {{ item.title|e('html_attr') }}">
                  <svg class="mobile-nav-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
              {% endif %}
              <ul class="mobile-dropdown">
                {% for child in item.children %}
                  {% set _child_class = (child.classes|default([])|join(' '))|trim %}
                  <li>
                    <a href="{{ child.link|e('esc_url') }}" class="mobile-nav-link {{ child.current ? 'active' : '' }} {{ _child_class }}" {{ child.is_target_blank ? ' target="_blank" rel="noopener noreferrer"' }}>
                      {{ child.title|e }}
                      <svg class="mobile-nav-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </li>
          {% else %}
            <li>
              {% set _contact_oid = (item.object_id|default(0)) + 0 %}
              {% if contactPageIds|default([])|length > 0 %}
                {% set _is_contact_item = _contact_oid > 0 and _contact_oid in contactPageIds %}
              {% else %}
                {% set _is_contact_item = (item.title == 'Contact Us' or item.title == 'Contact') %}
              {% endif %}
              {% set _show_active = item.current and not (isContactPage|default(false) and _is_contact_item) %}
              <a href="{{ item.link|e('esc_url') }}" class="mobile-nav-link {{ _show_active ? 'active' : '' }} {{ _is_contact_item ? 'contact-btn' }} {{ _item_class }}" {{ item.is_target_blank ? ' target="_blank" rel="noopener noreferrer"' }}>
                {{ item.title|e }}
                <svg class="mobile-nav-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </li>
          {% endif %}
        {% endfor %}
        {% if languageSwitcherLanguages|default([])|length > 0 %}
          <li class="mobile-dropdown-parent mobile-language" role="none">
            <a href="#language" class="mobile-nav-link mobile-dropdown-toggle">
              {{ labels.languageLabel|default('')|e }}
              <svg class="mobile-nav-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <ul class="mobile-dropdown">
              {% for lang in languageSwitcherLanguages %}
                <li>
                  <a href="{{ lang.url|e('esc_url') }}" class="mobile-nav-link" hreflang="{{ lang.slug|e('html_attr') }}" lang="{{ lang.slug|e('html_attr') }}">
                    {% if lang.current_lang %}<span class="lang-check" aria-hidden="true">✓</span>{% endif %}
                    {{ lang.name|e }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </li>
        {% endif %}
      </ul>
      {% endif %}
    </div>
  </header>

  {# Desktop Header (shows for xl and up) #}
  <header class="desktop-header {% if headerClass %}{{ headerClass|e }}{% endif %} hidden xl:block">
    <div class="wrapper">
      <logo>
        <a href="{{ site.link|e('esc_url') }}">
          {% set _desktopLogoWhite = (logoWhite.src|default(logoWhite.url))|default('')|trim %}
          {% set _desktopLogo = (logo.src|default(logo.url))|default('')|trim %}
          <img src="{{ (_desktopLogoWhite|length ? _desktopLogoWhite : buildUri ~ '/img/logo-white.png')|e('esc_url') }}" class="logo-white" alt="{{ (logoWhite.alt|default(''))|e }}" loading="eager" fetchpriority="low" />
          <img src="{{ (_desktopLogo|length ? _desktopLogo : buildUri ~ '/img/logo.png')|e('esc_url') }}" class="logo" alt="{{ (logo.alt|default(''))|e }}" loading="eager" fetchpriority="low" />
        </a>
      </logo>
      {% if menu %}
      <nav aria-label="{{ labels.ariaLabel|e }}">
        <ul class="nav">
          {% for item in menu.items %}
            {% set _item_class = (item.classes|default([])|join(' '))|trim %}
            {% if item.children %}
              {% set _parent_toggle_only = 'no-link-cursor' in (item.classes|default([])) %}
              <li>
                {% if _parent_toggle_only %}
                <a class="no-link-cursor {{ item.current_ancestor ? 'active' : '' }} {{ _item_class }}">{{ item.title|e }} <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" class="inline-block ml-1"><path d="M6 9L1 4H11L6 9Z" fill="currentColor"/></svg></a>
                {% else %}
                <a href="{{ item.link|e('esc_url') }}" class="{{ item.current or item.current_ancestor ? 'active' : '' }} {{ _item_class }}"{{ item.is_target_blank ? ' target="_blank" rel="noopener noreferrer"' }}>{{ item.title|e }} <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" class="inline-block ml-1"><path d="M6 9L1 4H11L6 9Z" fill="currentColor"/></svg></a>
                {% endif %}
                <ul class="dropdown">
                  {% for child in item.children %}
                    {% set _child_class = (child.classes|default([])|join(' '))|trim %}
                    <li><a href="{{ child.link|e('esc_url') }}" class="{{ child.current ? 'active' : '' }} {{ _child_class }}" {{ child.is_target_blank ? ' target="_blank" rel="noopener noreferrer"' }}>{{ child.title|e }}</a></li>
                  {% endfor %}
                </ul>
              </li>
            {% else %}
              {# On contact page (any language), do not add active to the Contact menu item (contact-btn). #}
              {% set _contact_oid = (item.object_id|default(0)) + 0 %}
              {% if contactPageIds|default([])|length > 0 %}
                {% set _is_contact_item = _contact_oid > 0 and _contact_oid in contactPageIds %}
              {% else %}
                {% set _is_contact_item = (item.title == 'Contact Us' or item.title == 'Contact') %}
              {% endif %}
              {% set _show_active = item.current and not (isContactPage|default(false) and _is_contact_item) %}
              <li><a href="{{ item.link|e('esc_url') }}" class="{{ _show_active ? 'active' : '' }} {{ _is_contact_item ? 'contact-btn' }} {{ _item_class }}" {{ item.is_target_blank ? ' target="_blank" rel="noopener noreferrer"' }}>{{ item.title|e }}</a></li>
            {% endif %}
          {% endfor %}
          {% if languageSwitcherLanguages|default([])|length > 0 %}
            <li class="lang-switcher" role="none">
              <a href="#language" class="no-link-cursor">{{ languageSwitcherDesktopCode|default('')|e }} <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" class="inline-block ml-1"><path d="M6 9L1 4H11L6 9Z" fill="currentColor"/></svg></a>
              <ul class="dropdown" role="menu" aria-label="{{ languageSwitcherAria|default('Languages')|e }}">
                {% for lang in languageSwitcherLanguages %}
                  <li role="none"><a role="menuitem" href="{{ lang.url|e('esc_url') }}" hreflang="{{ lang.slug|e('html_attr') }}" lang="{{ lang.slug|e('html_attr') }}" class="{{ lang.current_lang ? 'active' : '' }}">{{ lang.name|e }}</a></li>
                {% endfor %}
              </ul>
            </li>
          {% endif %}
        </ul>
      </nav>
      {% endif %}
    </div>
  </header>
</nsc-software-component>
