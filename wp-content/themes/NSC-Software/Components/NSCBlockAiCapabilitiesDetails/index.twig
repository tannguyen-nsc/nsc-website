{% if not (options.hidden|default(0)) %}
<nsc-software-component name="NSCBlockAiCapabilitiesDetails">
  <section class="our-capabilities-details">
    <div class="heading">
      {% if headingIcon.url or headingIcon.src %}
        <img src="{{ (headingIcon.url|default(headingIcon.src))|e('esc_url') }}" alt="{{ (headingIcon.alt|default(''))|e }}" loading="lazy" />
      {% elseif theme.buildUri %}
        <img src="{{ theme.buildUri }}/img/heading-icon.png" alt="Heading Icon" loading="lazy" />
      {% endif %}
      {% if title %}<h2>{{ title|raw }}</h2>{% endif %}
    </div>
    <div class="wrapper">
      {% if description %}
        <div class="description">
          {{ description|raw }}
        </div>
      {% endif %}
      <div class="content">
        {% for row in rows %}
          <div class="col left-col">
            {% if row.title %}<h2>{{ row.title|raw }}</h2>{% endif %}
            {% if row.badge %}<bandage>{{ row.badge|e }}</bandage>{% endif %}
          </div>
          <div class="col right-col">
            {% if row.images is iterable and row.images|length %}
              {% for img in row.images %}
                <img src="{{ (img.url|default(img.sizes.medium.url))|e('esc_url') }}" alt="{{ (img.alt|default(row.title))|e }}" loading="lazy" />
              {% endfor %}
            {% endif %}
          </div>
        {% endfor %}
      </div>
      {% if quote %}
        <div class="quote">
          {{ quote|raw }}
        </div>
      {% endif %}
    </div>
  </section>
</nsc-software-component>
{% endif %}
