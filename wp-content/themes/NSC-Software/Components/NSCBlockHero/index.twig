{#
  Hero styles (from frontend build):
  - home: section.hero.home (wave animation), one image, iso-logos, CTA button
  - left_text: section.hero.left-text (About us), desktop + mobile images, no iso-logos
  - dark: section.hero.dark (AI / Our Services), one or two images, no iso-logos
#}
{% if not (options.hidden|default(0)) %}
{% set style = heroStyle|default('home') %}
{% set sectionClass = 'hero ' ~ (style == 'left_text' ? 'left-text' : style) %}
<nsc-software-component name="NSCBlockHero">
  <section class="{{ sectionClass }}">
  {% if style == 'home' %}
    {# Home: single background image (wave canvas is injected by wave.js when .hero.home exists) #}
    {% if image.url or image.src %}
      <img src="{{ (image.url|default(image.src))|e('esc_url') }}" alt="{{ (image.alt|default(''))|e }}" loading="lazy" />
    {% elseif theme.buildUri %}
      <img src="{{ theme.buildUri }}/img/hero-light.png" alt="" loading="lazy" />
    {% endif %}
    <div class="headlines animate__animated animate__zoomIn">
      <h1>{{ headline|raw }}</h1>
      <div class="description">
        {% if badgeImages|length %}
          <div class="iso-logos">
            {% for badge in badgeImages %}{% if badge.image.url or badge.image.src %}
              <img src="{{ (badge.image.url|default(badge.image.src))|e('esc_url') }}" alt="{{ (badge.image.alt|default(''))|e }}" loading="lazy" />
            {% endif %}{% endfor %}
          </div>
          <br class="lg:hidden">
        {% elseif theme.buildUri %}
          <div class="iso-logos">
            <img src="{{ theme.buildUri }}/img/ISO-27001.png" alt="ISO 27001 Information Security Logo" loading="lazy" />
            <img src="{{ theme.buildUri }}/img/ISO-9001-2015.png" alt="ISO 9001:2015 Quality Management Logo" loading="lazy" />
          </div>
          <br class="lg:hidden">
        {% endif %}
        {% if description %}<div>{{ description|raw }}</div>{% endif %}
      </div>
      {% if button.label and button.url %}
        <div class="buttons">
          <a href="{{ button.url|e('esc_url') }}" class="btn-explore" {{ button.openInNewTab ? ' target="_blank" rel="noopener noreferrer"' }}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M10.9999 5C10.9999 4.44772 11.4476 4 11.9999 4C12.5522 4 12.9999 4.44772 12.9999 5V16.5859L18.2929 11.293C18.6834 10.9024 19.3164 10.9024 19.707 11.293C20.0975 11.6835 20.0975 12.3165 19.707 12.707L12.707 19.707C12.3164 20.0976 11.6834 20.0976 11.2929 19.707L4.29289 12.707C3.90237 12.3165 3.90237 11.6835 4.29289 11.293C4.68342 10.9024 5.31643 10.9024 5.70696 11.293L10.9999 16.5859V5Z" fill="#FFFFFF"/>
            </svg>
            {{ button.label|e }}
          </a>
        </div>
      {% endif %}
    </div>
  {% elseif style == 'left_text' %}
    {# About us: desktop + mobile images, headlines right #}
    {% if imageDesktop.url or imageDesktop.src %}
      <img src="{{ (imageDesktop.url|default(imageDesktop.src))|e('esc_url') }}" alt="{{ (imageDesktop.alt|default(''))|e }}" class="xl:block hidden" loading="eager" fetchpriority="high" />
    {% elseif theme.buildUri %}
      <img src="{{ theme.buildUri }}/img/hero-left-text.png" alt="" class="xl:block hidden" loading="eager" fetchpriority="high" />
    {% endif %}
    {% if imageMobile.url or imageMobile.src %}
      <img src="{{ (imageMobile.url|default(imageMobile.src))|e('esc_url') }}" alt="{{ (imageMobile.alt|default(''))|e }}" class="xl:hidden" loading="eager" fetchpriority="high" />
    {% elseif theme.buildUri %}
      <img src="{{ theme.buildUri }}/img/hero-left-text-mob.png" alt="" class="xl:hidden" loading="eager" fetchpriority="high" />
    {% endif %}
    <div class="headlines animate__animated animate__fadeInRightBig">
      <h1>{{ headline|raw }}</h1>
      <div class="description">
        {% if description %}<p>{{ description|raw }}</p>{% endif %}
      </div>
      {% if button.label and button.url %}
        <div class="buttons">
          <a href="{{ button.url|e('esc_url') }}" class="btn-explore" {{ button.openInNewTab ? ' target="_blank" rel="noopener noreferrer"' }}>{{ button.label|e }}</a>
        </div>
      {% endif %}
    </div>
  {% else %}
    {# dark (AI / Our Services): one image or desktop + mobile #}
    {% if imageDesktop.url or imageDesktop.src or imageMobile.url or imageMobile.src %}
      {% if imageDesktop.url or imageDesktop.src %}
        <img src="{{ (imageDesktop.url|default(imageDesktop.src))|e('esc_url') }}" alt="{{ (imageDesktop.alt|default(''))|e }}" class="xl:block hidden" loading="lazy" />
      {% elseif theme.buildUri %}
        <img src="{{ theme.buildUri }}/img/ai-hero.png" alt="" class="xl:block hidden" loading="lazy" />
      {% endif %}
      {% if imageMobile.url or imageMobile.src %}
        <img src="{{ (imageMobile.url|default(imageMobile.src))|e('esc_url') }}" alt="{{ (imageMobile.alt|default(''))|e }}" class="xl:hidden" loading="lazy" />
      {% elseif theme.buildUri %}
        <img src="{{ theme.buildUri }}/img/mob-ai-hero.png" alt="" class="xl:hidden" loading="lazy" />
      {% endif %}
    {% else %}
      {% if image.url or image.src %}
        <img src="{{ (image.url|default(image.src))|e('esc_url') }}" alt="{{ (image.alt|default(''))|e }}" loading="lazy" />
      {% elseif theme.buildUri %}
        <img src="{{ theme.buildUri }}/img/hero-dark.png" alt="" loading="lazy" />
      {% endif %}
    {% endif %}
    <div class="headlines animate__animated animate__zoomIn">
      <h1>{{ headline|raw }}</h1>
      <div class="description">
        <br class="lg:hidden">
        {% if description %}<p>{{ description|raw }}</p>{% endif %}
      </div>
      {% if button.label and button.url %}
        <div class="buttons">
          <a href="{{ button.url|e('esc_url') }}" class="btn-explore" {{ button.openInNewTab ? ' target="_blank" rel="noopener noreferrer"' }}>{{ button.label|e }}</a>
        </div>
      {% endif %}
    </div>
  {% endif %}
  </section>
</nsc-software-component>
{% endif %}
