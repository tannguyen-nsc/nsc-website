{% if not (options.hidden|default(0)) %}
<nsc-software-component name="NSCBlockAiImpact">
  <section class="ai-impact" {% if backgroundImage.url or backgroundImage.src %}style="background-image: url('{{ (backgroundImage.url|default(backgroundImage.src))|e('esc_url') }}'); background-size: cover; background-position: center; background-repeat: no-repeat;"{% elseif theme.buildUri %}style="background-image: url('{{ theme.buildUri }}/img/ai-impact-bg.png'); background-size: cover; background-position: center; background-repeat: no-repeat;"{% endif %}>
    <div class="wrapper">
      <div class="heading light">
        {% if headingIcon.url or headingIcon.src %}
          <img src="{{ (headingIcon.url|default(headingIcon.src))|e('esc_url') }}" alt="{{ (headingIcon.alt|default(''))|e }}" loading="lazy" />
        {% elseif theme.buildUri %}
          <img src="{{ theme.buildUri }}/img/heading-icon.png" alt="Heading Icon" loading="lazy" />
        {% endif %}
        {% if title %}<h2>{{ title|raw }}</h2>{% endif %}
      </div>
      <div class="ai-impact-grid">
        {% for item in items %}
          <div class="ai-impact-item{% if loop.index == 2 %} active{% endif %}" data-index="{{ loop.index0 }}">
            <div class="ai-impact-item-header">
              {% if item.num %}<span class="ai-impact-item-num">{{ item.num|e }}</span>{% endif %}
              {% if item.title %}<h2 class="ai-impact-item-title">{{ item.title|raw }}</h2>{% endif %}
              <button type="button" class="ai-impact-item-toggle" aria-expanded="{{ loop.index == 2 ? 'true' : 'false' }}" aria-label="{{ loop.index == 2 ? 'Collapse' : 'Expand' }}">
                <svg class="icon-plus" width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M12.8327 22.1665V15.1665H5.83268C5.18835 15.1665 4.66602 14.6442 4.66602 13.9998C4.66602 13.3555 5.18835 12.8332 5.83268 12.8332H12.8327V5.83317C12.8327 5.18884 13.355 4.6665 13.9993 4.6665C14.6437 4.6665 15.166 5.18884 15.166 5.83317V12.8332H22.166C22.8103 12.8332 23.3327 13.3555 23.3327 13.9998C23.3327 14.6442 22.8103 15.1665 22.166 15.1665H15.166V22.1665C15.166 22.8108 14.6437 23.3332 13.9993 23.3332C13.355 23.3332 12.8327 22.8108 12.8327 22.1665Z" fill="currentColor"/>
                </svg>
                <svg class="icon-minus" width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M22.166 12.8335C22.8103 12.8335 23.3327 13.3558 23.3327 14.0002C23.3327 14.6445 22.8103 15.1668 22.166 15.1668H5.83268C5.18835 15.1668 4.66602 14.6445 4.66602 14.0002C4.66602 13.3558 5.18835 12.8335 5.83268 12.8335H22.166Z" fill="currentColor"/>
                </svg>
              </button>
            </div>
            <div class="ai-impact-item-content">
              {% if item.content %}{{ item.content|raw }}{% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
</nsc-software-component>
{% endif %}
