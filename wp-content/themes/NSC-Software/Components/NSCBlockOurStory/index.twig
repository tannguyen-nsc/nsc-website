{% if not (options.hidden|default(0)) %}
<nsc-software-component name="NSCBlockOurStory">
  <section class="our-story">
    <div class="heading">
      {% if headingIcon.url or headingIcon.src %}
        <img src="{{ (headingIcon.url|default(headingIcon.src))|e('esc_url') }}" alt="{{ (headingIcon.alt|default(''))|e }}" loading="lazy" />
      {% elseif theme.buildUri %}
        <img src="{{ theme.buildUri }}/img/heading-icon.png" alt="Heading Icon" loading="lazy" />
      {% endif %}
      <h2>{{ title|e }}</h2>
    </div>
    {% if content %}
      <div class="content">
        {{ content|raw }}
      </div>
    {% endif %}
    <div class="wrapper">
      {% for col in columns %}
        <div class="col">
          {% if col.title %}<h2>{{ col.title|raw }}</h2>{% endif %}
          {% if col.description %}
            <div class="description">
              <p>{{ col.description|e }}</p>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </section>
</nsc-software-component>
{% endif %}
