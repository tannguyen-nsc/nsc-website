{% if not (options.hidden|default(0)) %}
<nsc-software-component name="NSCBlockSectionHeading" class="heading {{ light ? 'light' : '' }}">
  {% if icon.url or icon.src %}
    <img src="{{ (icon.url|default(icon.src))|e('esc_url') }}" alt="{{ (icon.alt|default(''))|e }}" loading="lazy" />
  {% elseif theme.buildUri %}
    <img src="{{ theme.buildUri }}/img/heading-icon.png" alt="" loading="lazy" />
  {% endif %}
  <h2>{{ title|e }}</h2>
</nsc-software-component>
{% endif %}
