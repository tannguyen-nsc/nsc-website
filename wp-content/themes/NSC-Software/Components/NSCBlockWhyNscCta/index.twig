{% if not (options.hidden|default(0)) %}
{% set btn = button|default({}) %}
{% set btnUrl = btn.url|default('')|trim %}
{% set ctaHref = btnUrl != '' ? btnUrl : function('nsc_resolve_page_permalink', 'contact') %}
<nsc-software-component name="NSCBlockWhyNscCta">
    <section class="why-nsc-cta" id="section-start-building" aria-labelledby="why-nsc-cta-heading">
      <div class="why-nsc-cta__panel">
        <div class="why-nsc-cta__inner">
          <h2 id="why-nsc-cta-heading">{{ (title|default('Start Building with NSC Software'))|e }}</h2>
          <p>{{ (body|default(''))|e }}</p>
          <a href="{{ ctaHref|e('esc_url') }}" class="why-nsc-cta__btn"{% if btn.openInNewTab|default(0) %} target="_blank" rel="noopener noreferrer"{% endif %}>
            <span class="why-nsc-cta__btn-text">{{ (btn.label|default(''))|e }}</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M8.59 16.59L13.17 12L8.59 7.41L10 6L16 12L10 18L8.59 16.59Z" fill="currentColor"/>
            </svg>
          </a>
        </div>
      </div>
    </section>
</nsc-software-component>
{% endif %}
