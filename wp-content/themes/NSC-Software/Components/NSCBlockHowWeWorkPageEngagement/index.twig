{% if not (options.hidden|default(0)) %}
{% set models = engagementModels|default([]) %}
{% set steps = processSteps|default([]) %}
{% set box1 = boxBestSuitedTitle|default('Best suited for') %}
{% set box2 = boxKeyBenefitsTitle|default('Key benefits') %}
{% set collabH = collaborationHeading|default('Our Collaboration Process') %}
{% set bgD = backgroundDesktop.url|default(backgroundDesktop.src)|default('') %}
{% set bgM = backgroundMobile.url|default(backgroundMobile.src)|default('') %}
{% set bgDesk = bgD != '' ? bgD : (theme.buildUri ~ '/img/how-we-work-page-engagement-bg.png') %}
{% set bgMob = bgM != '' ? bgM : (theme.buildUri ~ '/img/how-we-work-page-engagement-bg-mob.png') %}
{% set hi = headingIcon.url|default(headingIcon.src)|default('') %}
{% set iconSrc = hi != '' ? hi : (theme.buildUri ~ '/img/heading-icon.webp') %}
<nsc-software-component name="NSCBlockHowWeWorkPageEngagement">
  <section class="how-we-work-page-engagement" id="section-hww-engagement" aria-labelledby="hww-engagement-heading">
    <div class="how-we-work-page-engagement__bg" aria-hidden="true">
      <img src="{{ bgDesk|e('esc_url') }}" alt="" class="how-we-work-page-engagement__bg-img how-we-work-page-engagement__bg-img--desktop hidden lg:block" width="1920" height="900" loading="lazy" />
      <img src="{{ bgMob|e('esc_url') }}" alt="" class="how-we-work-page-engagement__bg-img how-we-work-page-engagement__bg-img--mob lg:hidden" width="750" height="1200" loading="lazy" />
    </div>
    <div class="wrapper">
      <header class="how-we-work-page-engagement__heading">
        <div class="heading light">
          <img src="{{ iconSrc|e('esc_url') }}" alt="" width="56" height="56" loading="lazy" />
          <h2 id="hww-engagement-heading">{{ (sectionHeading|default('Our Engagement Models'))|e }}</h2>
        </div>
      </header>

      <div class="hww-engagement__tabs hidden lg:flex" role="tablist" aria-label="{{ (sectionHeading|default('Engagement models'))|e }}">
        {% for model in models %}
        <button type="button" class="hww-engagement__tab{% if loop.first %} hww-engagement__tab--active{% endif %}" role="tab" aria-selected="{{ loop.first ? 'true' : 'false' }}" data-hww-tab="{{ loop.index0 }}">
          <span class="hww-engagement__tab-num" aria-hidden="true">{% if model.tabNumber|default('')|trim != '' %}{{ model.tabNumber|e }}{% else %}{{ loop.index }}{% endif %}</span>
          <span class="hww-engagement__tab-label">{{ model.tabLabel|e }}</span>
          <span class="hww-engagement__tab-arrow" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M8.293 4.29289C7.90237 4.68342 7.90237 5.31643 8.293 5.70696L13.5859 10.9999H2C1.44772 10.9999 1 11.4476 1 11.9999C1 12.5522 1.44772 12.9999 2 12.9999H13.5859L8.293 18.2929C7.90237 18.6834 7.90237 19.3164 8.293 19.707C8.68342 20.0975 9.31643 20.0975 9.70696 19.707L16.707 12.707C17.0976 12.3164 17.0976 11.6834 16.707 11.293L9.70696 4.29289C9.31643 3.90237 8.68342 3.90237 8.293 4.29289Z" fill="currentColor"/></svg>
          </span>
        </button>
        {% endfor %}
      </div>

      <div class="hww-engagement__panels hidden lg:block">
        {% for model in models %}
        <div class="hww-engagement__panel{% if loop.first %} hww-engagement__panel--active{% endif %}" data-hww-panel="{{ loop.index0 }}" role="tabpanel">
          <div class="hww-engagement__panel-shell">
            <div class="hww-engagement__panel-body">
              <div class="hww-engagement__panel-inner">
                <div class="hww-engagement__panel-lead">
                  {% if model.leadStrong|default('') %}<p class="hww-engagement__panel-lead-strong">{{ model.leadStrong|e }}</p>{% endif %}
                  {% if model.leadParagraph|default('') %}<p>{{ model.leadParagraph|e }}</p>{% endif %}
                </div>
                <div class="hww-engagement__panel-aside">
                  <div class="hww-engagement__box">
                    <p class="hww-engagement__box-title">{{ box1|e }}</p>
                    <ul>
                      {% for row in model.bestSuitedLines|default([]) %}
                      {% if row.text|default('') %}<li>{{ row.text|e }}</li>{% endif %}
                      {% endfor %}
                    </ul>
                  </div>
                  <div class="hww-engagement__box">
                    <p class="hww-engagement__box-title">{{ box2|e }}</p>
                    <ul>
                      {% for row in model.keyBenefitLines|default([]) %}
                      {% if row.text|default('') %}<li>{{ row.text|e }}</li>{% endif %}
                      {% endfor %}
                    </ul>
                  </div>
                </div>
              </div>
              <div class="how-we-work-page-collaboration-process hww-engagement__collab-process">
                <h3 class="how-we-work-page-engagement__process-heading">{{ collabH|e }}</h3>
                <div class="how-we-work-page-collaboration-process__grid">
                  {% for step in steps %}
                  <article class="hww-process-card" tabindex="0">
                    <div class="hww-process-card__figure">
                      {% set simg = step.image.url|default(step.image.src)|default('') %}
                      {% if simg != '' %}
                      <img src="{{ simg|e('esc_url') }}" alt="" width="400" height="300" loading="lazy" />
                      {% endif %}
                    </div>
                    <div class="hww-process-card__body">
                      <div class="hww-process-card__top">
                        <p class="hww-process-card__step">{{ (step.stepLabel|default(''))|e }}</p>
                        <span class="hww-process-card__arrow{% if loop.last %} hww-process-card__arrow--last{% endif %}" aria-hidden="true"></span>
                      </div>
                      <h4 class="hww-process-card__title">{{ (step.title|default(''))|e }}</h4>
                      {% if step.description|default('') %}<p class="hww-process-card__description">{{ step.description|e }}</p>{% endif %}
                    </div>
                  </article>
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>

      <div class="hww-engagement__mob-grid service-items lg:hidden">
        <div class="hww-engagement__mob-list col">
          {% for model in models %}
          <div class="hww-engagement__mob-item{% if loop.first %} active{% endif %}" role="button" tabindex="0" data-hww-panel-ref="{{ loop.index0 }}">
            <h2><span>{% if model.tabNumber|default('')|trim != '' %}{{ model.tabNumber|e }}{% else %}{{ loop.index }}{% endif %}</span> {{ model.tabLabel|e }}</h2>
            <div class="arrow-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8.293 4.29289C7.90237 4.68342 7.90237 5.31643 8.293 5.70696L13.5859 10.9999H2C1.44772 10.9999 1 11.4476 1 11.9999C1 12.5522 1.44772 12.9999 2 12.9999H13.5859L8.293 18.2929C7.90237 18.6834 7.90237 19.3164 8.293 19.707C8.68342 20.0975 9.31643 20.0975 9.70696 19.707L16.707 12.707C17.0976 12.3164 17.0976 11.6834 16.707 11.293L9.70696 4.29289C9.31643 3.90237 8.68342 3.90237 8.293 4.29289Z" fill="currentColor"/></svg>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>

      <div class="bottom-sheet-overlay" id="hwwEngagementBottomSheetOverlay"></div>
      <div class="bottom-sheet hww-engagement-bottom-sheet" id="hwwEngagementBottomSheet">
        <div class="bottom-sheet-header">
          <h3 class="bottom-sheet-title" id="hwwEngagementBottomSheetTitle"></h3>
          <button type="button" class="bottom-sheet-close" id="hwwEngagementBottomSheetClose" aria-label="Close">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M21 7L7 21M7 7L21 21" stroke="#F9F9FB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        <div class="bottom-sheet-content">
          <div class="hww-engagement-sheet-body" id="hwwEngagementBottomSheetContent"></div>
        </div>
      </div>
    </div>
  </section>
</nsc-software-component>
{% endif %}
