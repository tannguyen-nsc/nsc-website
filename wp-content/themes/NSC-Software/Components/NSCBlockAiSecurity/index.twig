{% if not (options.hidden|default(0)) %}
<nsc-software-component name="NSCBlockAiSecurity">
  <section class="ai-security" {% if backgroundImage.url or backgroundImage.src %}style="background-image: url('{{ (backgroundImage.url|default(backgroundImage.src))|e('esc_url') }}'); background-size: cover; background-position: center; background-repeat: no-repeat;"{% elseif theme.buildUri %}style="background-image: url('{{ theme.buildUri }}/img/ai-security-bg.png'); background-size: cover; background-position: center; background-repeat: no-repeat;"{% endif %}>
    <div class="wrapper">
      <div class="heading light">
        {% if headingIcon.url or headingIcon.src %}
          <img src="{{ (headingIcon.url|default(headingIcon.src))|e('esc_url') }}" alt="{{ (headingIcon.alt|default(''))|e }}" loading="lazy" />
        {% elseif theme.buildUri %}
          <img src="{{ theme.buildUri }}/img/heading-icon.png" alt="Heading Icon" loading="lazy" />
        {% endif %}
        {% if title %}<h2>{{ title|raw }}</h2>{% endif %}
      </div>
      {% if subtitle %}
        <div class="description animate__animated animate__zoomIn">
          <h3>{{ subtitle|e }}</h3>
        </div>
      {% endif %}
      <div class="item-wrapper">
        <div class="items">
          {% for item in items %}
            <div class="item">
              <div class="content animate__animated animate__flipInY">
                {% if item.title %}<h3>{{ item.title|e }}</h3>{% endif %}
                {% if item.content %}<p>{{ item.content|e }}</p>{% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
</nsc-software-component>
{% endif %}
