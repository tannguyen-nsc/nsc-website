{% if not (options.hidden|default(0)) %}
{% set hi = headingIcon.url|default(headingIcon.src)|default('') %}
{% set iconSrc = hi != '' ? hi : (theme.buildUri ~ '/img/heading-icon.webp') %}
{% set lineBlack = headingLineBlack|default('Built for') %}
{% set lineAccent = title|default('Long-Term Partnerships') %}
<nsc-software-component name="NSCBlockHowWeWorkPageLongterm">
  <section class="how-we-work-page-longterm" id="section-hww-longterm" aria-labelledby="hww-longterm-heading">
    <div class="wrapper">
      <div class="why-nsc-team__heading-col">
        <img src="{{ iconSrc|e('esc_url') }}" alt="" class="why-nsc-team__icon" width="56" height="56" loading="lazy" />
        <h2 id="hww-longterm-heading" class="why-nsc-team__title">
          <span class="why-nsc-team__title-pre">{{ lineBlack|e }}</span>
          <span class="why-nsc-team__title-row">
            <span class="why-nsc-team__accent">{{ lineAccent|e }}</span>
          </span>
        </h2>
      </div>
      {% if body|default('') %}
      <div class="how-we-work-page-longterm__text">
        <p>{{ body|e }}</p>
      </div>
      {% endif %}
    </div>
  </section>
</nsc-software-component>
{% endif %}
