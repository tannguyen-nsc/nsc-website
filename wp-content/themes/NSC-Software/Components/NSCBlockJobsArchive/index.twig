{% if not (options.hiddenJobsArchive|default(0)) %}
<nsc-software-component name="NSCBlockJobsArchive">
  <script>
    window.jobVueData = {{ (job_vue_data_json|default('{}'))|raw }};
  </script>
  <section class="open-positions" id="open-positions-app" v-cloak>
    <div class="wrapper">
      <div class="heading">
        {% if headingIcon.url or headingIcon.src %}
          <img src="{{ (headingIcon.url|default(headingIcon.src))|e('esc_url') }}" alt="{{ (headingIcon.alt|default(''))|e }}" loading="lazy" />
        {% elseif theme.buildUri %}
          <img src="{{ theme.buildUri|e('esc_url') }}/img/heading-icon.png" alt="" loading="lazy" />
        {% endif %}
        <h2>{{ title|default('OPEN POSITIONS')|e }}</h2>
      </div>
      {% if intro %}
        <div class="intro">{{ intro|raw }}</div>
      {% endif %}
      <div class="positions-list">
        {% verbatim %}
        <div class="positions-tabs">
          <button type="button" class="tab" :class="{ 'tab-active': activeTab === tab.id }" v-for="tab in tabs" :key="tab.id" @click="setTab(tab.id)">{{ tab.label }}</button>
        </div>
        <div class="positions-items">
          <div v-if="loading" class="positions-loading">
            <p>{{ labels.loading }}</p>
          </div>
          <template v-else-if="loadError">
            <div class="positions-empty">
              <p>{{ loadError }}</p>
            </div>
          </template>
          <template v-else-if="paginatedJobs.length">
            <div class="positions-item" v-for="job in paginatedJobs" :key="job.id">
              <div class="positions-item-content">
                <a :href="job.link" class="job-title">{{ job.title }}</a>
                <div class="job-meta">
                  <span class="date">{{ job.date }}</span>
                  <span class="company">{{ job.company }}</span>
                  <span class="type">{{ job.type }}</span>
                </div>
              </div>
              <div class="apply-wrap">
                <a :href="job.link" class="apply-btn">{{ uiLabels.applyNow }} <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
              </div>
            </div>
          </template>
          <div v-else class="positions-empty">
            <p>{{ labels.empty }}</p>
          </div>
        </div>
        <div class="pagination positions-pagination" v-if="totalPages > 1">
          <button type="button" class="pagination-prev" :disabled="currentPage <= 1" @click="setPage(currentPage - 1)"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> {{ labels.previous }}</button>
          <div class="pagination-numbers">
            <template v-for="page in displayPages" :key="page.num || 'ellipsis'">
              <button v-if="!page.isEllipsis" type="button" class="pagination-num" :class="{ 'pagination-num-active': currentPage === page.num }" @click="setPage(page.num)">{{ page.num }}</button>
              <span v-else class="pagination-ellipsis">...</span>
            </template>
          </div>
          <button type="button" class="pagination-next" :disabled="currentPage >= totalPages" @click="setPage(currentPage + 1)">{{ labels.next }} <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
        {% endverbatim %}
      </div>
    </div>
  </section>
</nsc-software-component>
{% endif %}
