{% if not (options.hidden|default(0)) %}
<nsc-software-component name="NSCBlockWhyUs" {{ options.theme ? 'data-theme="' ~ options.theme ~ '"' }}>
  <section id="why-us" class="why-us {{ options.theme ? 'theme-' ~ options.theme : '' }}">
  {% if backgroundImage.url or backgroundImage.src %}
    <img src="{{ (backgroundImage.url|default(backgroundImage.src))|e('esc_url') }}" class="xl:block hidden" alt="" loading="lazy" />
  {% elseif theme.buildUri %}
    <img src="{{ theme.buildUri }}/img/why-nsc-bg.png" class="xl:block hidden" loading="lazy" alt="" />
  {% endif %}
  {% if backgroundImageMobile.url or backgroundImageMobile.src %}
    <img src="{{ (backgroundImageMobile.url|default(backgroundImageMobile.src))|e('esc_url') }}" class="md:hidden mob-top-pattern" alt="" loading="lazy" />
  {% elseif theme.buildUri %}
    <img src="{{ theme.buildUri }}/img/mob-why-nsc-bg.png" class="md:hidden mob-top-pattern" loading="lazy" alt="" />
  {% endif %}
  <div id="globe-container" class="why-us-globe-3d" aria-hidden="true" role="presentation"></div>
  <div class="heading light">
    {% if headingIcon.url or headingIcon.src %}
      <img src="{{ (headingIcon.url|default(headingIcon.src))|e('esc_url') }}" alt="{{ (headingIcon.alt|default(''))|e }}" loading="lazy" />
    {% elseif theme.buildUri %}
      <img src="{{ theme.buildUri }}/img/heading-icon.png" alt="Heading Icon" loading="lazy" />
    {% endif %}
    <h2>{{ title|e }}</h2>
  </div>
  {% if backgroundImage.url or backgroundImage.src %}
    <img src="{{ (backgroundImage.url|default(backgroundImage.src))|e('esc_url') }}" class="hidden md:block xl:hidden" loading="lazy" alt="" />
  {% elseif theme.buildUri %}
    <img src="{{ theme.buildUri }}/img/why-nsc-bg.png" class="hidden md:block xl:hidden" loading="lazy" alt="" />
  {% endif %}
  <div class="why-us-content">
    {% for item in items %}
      <div class="why-us-item" data-globe-index="{{ loop.index0 }}">
        <div class="content">
          <h3>{{ item.title|e }}</h3>
          <div class="description">{% if item.description %}<p>{{ item.description|e }}</p>{% endif %}</div>
        </div>
      </div>
    {% endfor %}
  </div>
  </section>
</nsc-software-component>
{% endif %}
