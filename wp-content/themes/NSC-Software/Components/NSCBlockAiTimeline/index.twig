{% if not (options.hidden|default(0)) %}
<nsc-software-component name="NSCBlockAiTimeline">
  <section class="timeline" {% if backgroundImage.url or backgroundImage.src %}style="background-image: url('{{ (backgroundImage.url|default(backgroundImage.src))|e('esc_url') }}'); background-size: cover; background-position: center; background-repeat: no-repeat;"{% elseif theme.buildUri %}style="background-image: url('{{ theme.buildUri }}/img/timeline-bg.webp'); background-size: cover; background-position: center; background-repeat: no-repeat;"{% endif %}>
    <div class="wrapper">
      <div class="info">
        <div class="col">
          {% if headingIcon.url or headingIcon.src %}
            <img src="{{ (headingIcon.url|default(headingIcon.src))|e('esc_url') }}" alt="{{ (headingIcon.alt|default(''))|e }}" loading="lazy" />
          {% elseif theme.buildUri %}
            <img src="{{ theme.buildUri }}/img/heading-icon.webp" alt="Heading Icon" loading="lazy" />
          {% endif %}
          {% if title %}<h2>{{ title|raw }}</h2>{% endif %}
          {% if description %}
            <div class="description">
              {{ description|raw }}
            </div>
          {% endif %}
        </div>
        <div class="col">
          <div class="timeline-items">
            {% for phase in phases %}
              <div class="timeline-item">
                <div class="timeline-item-milestone">
                  <span>{{ phase.milestone|e }}</span>
                </div>
                <div class="timeline-item-content">
                  {% if phase.title %}<h2>{{ phase.title|e }}</h2>{% endif %}
                  {% if phase.content %}{{ phase.content|raw }}{% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
      {% if quote %}
        <div class="quote">
          {{ quote|raw }}
        </div>
      {% endif %}
    </div>
  </section>
</nsc-software-component>
{% endif %}
