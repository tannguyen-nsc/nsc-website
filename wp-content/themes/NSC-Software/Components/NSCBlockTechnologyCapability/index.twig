{% if not (options.hidden|default(0)) %}
<nsc-software-component name="NSCBlockTechnologyCapability">
  <section class="our-capabilities-details">
    <div class="heading">
      {% if headingIcon.url or headingIcon.src %}
        <img src="{{ (headingIcon.url|default(headingIcon.src))|e('esc_url') }}" alt="{{ (headingIcon.alt|default(''))|e }}" loading="lazy" />
      {% elseif theme.buildUri %}
        <img src="{{ theme.buildUri }}/img/heading-icon.webp" alt="Heading Icon" loading="lazy" />
      {% endif %}
      {% if title %}<h2>{{ title|raw }}</h2>{% endif %}
    </div>
    <div class="wrapper">
      {% if description %}
        <div class="description">
          {{ description|raw }}
        </div>
      {% endif %}
      <div class="content">
        {% for row in rows %}
          <div class="col left-col">
            {% if row.title %}<h2>{{ row.title|raw }}</h2>{% endif %}
          </div>
          <div class="col right-col {{ row.rightColClass|default('')|e }}">
            {% if row.imageGroups is iterable and row.imageGroups|length %}
              {% for group in row.imageGroups %}
                {% if row.imageGroups|length == 1 and not (group.label|trim) %}
                  {# Single group with no label: flat list of images #}
                  {% for img in group.images %}
                    <img src="{{ (img.url|default(img.sizes.medium.url))|e('esc_url') }}" alt="{{ (img.alt|default(row.title))|e }}" loading="lazy" />
                  {% endfor %}
                {% else %}
                  <div class="row">
                    {% if group.label|trim %}<span>{{ group.label|e }}</span>{% endif %}
                    {% for img in group.images %}
                      <img src="{{ (img.url|default(img.sizes.medium.url))|e('esc_url') }}" alt="{{ (img.alt|default(row.title))|e }}" loading="lazy" />
                    {% endfor %}
                  </div>
                {% endif %}
              {% endfor %}
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
</nsc-software-component>
{% endif %}
