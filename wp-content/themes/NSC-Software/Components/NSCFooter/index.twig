{% macro render_sitemap_nav_item(item) %}
  {% set _item_class = (item.classes|default([])|join(' '))|trim %}
  {% if item.children|default([])|length %}
    <li>
      <a href="{{ item.link|e('esc_url') }}" class="{{ _item_class }}">{{ item.title|e }}</a>
      <ul>
        {% for child in item.children %}
          {% set _c_class = (child.classes|default([])|join(' '))|trim %}
          <li><a href="{{ child.link|e('esc_url') }}" class="{{ _c_class }}" {{ child.is_target_blank ? ' target="_blank" rel="noopener noreferrer"' }}>{{ child.title|e }}</a></li>
        {% endfor %}
      </ul>
    </li>
  {% else %}
    <li><a href="{{ item.link|e('esc_url') }}" class="{{ _item_class }}" {{ item.is_target_blank ? ' target="_blank" rel="noopener noreferrer"' }}>{{ item.title|e }}</a></li>
  {% endif %}
{% endmacro %}

<nsc-software-component name="NSCFooter">
  <footer>
    <div class="wrapper">
      <div class="col company-info">
        <div class="company-branding">
          <div class="logo">
            {% if logoMobile and (logoMobile.url or logoMobile.src) %}
              <img src="{{ (logoMobile.url|default(logoMobile.src))|e('esc_url') }}" alt="{{ companyName|e }}" class="block lg:hidden" loading="lazy" />
            {% elseif buildUri %}
              <img src="{{ buildUri }}/img/logo.png" alt="{{ companyName|e }}" class="block lg:hidden" loading="lazy" />
            {% endif %}
            {% if logo and (logo.url or logo.src) %}
              <img src="{{ (logo.url|default(logo.src))|e('esc_url') }}" alt="{{ companyName|e }}" class="hidden lg:block" loading="lazy" />
            {% elseif buildUri %}
              <img src="{{ buildUri }}/img/mob-foot-logo.webp" alt="{{ companyName|e }}" class="hidden lg:block" loading="lazy" />
            {% endif %}
          </div>
          <h3 class="company-name">{{ companyName|e }}</h3>
        </div>
        {% if companyDescription %}
          <p class="company-description">{{ companyDescription|e }}</p>
        {% endif %}
        {% if businessNumber %}
          <p class="business-number">{{ businessNumberLabel|e }} <br> {{ businessNumber|e }}</p>
        {% endif %}
        {% if certifications|length %}
          <div class="certifications">
            {% for cert in certifications %}
              {% if cert.image.url or cert.image.src %}
                <div class="cert-badge">
                  <img src="{{ (cert.image.url|default(cert.image.src))|e('esc_url') }}" alt="{{ (cert.image.alt|default(''))|e }}" loading="lazy" />
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% elseif buildUri %}
          <div class="certifications">
            <div class="cert-badge">
              <img src="{{ buildUri }}/img/ISO-27001.png" alt="ISO 27001" loading="lazy" />
            </div>
            <div class="cert-badge">
              <img src="{{ buildUri }}/img/ISO-9001-2015.png" alt="ISO 9001:2015" loading="lazy" />
            </div>
          </div>
        {% endif %}
        {% if email %}
          <p class="email">{{ emailLabel|e }} <br><a href="mailto:{{ email|e('html_attr') }}">{{ email|e }}</a></p>
        {% endif %}
      </div>
      <div class="col right-column">
        <div class="contact-info">
          <button class="accordion-toggle xl:hidden" aria-expanded="false" aria-controls="contact-content">
            <h4 class="section-heading">{{ contactHeading|e }}</h4>
            <svg xmlns="http://www.w3.org/2000/svg" class="accordion-icon" viewBox="0 0 24 24" fill="none">
              <path d="M11.293 4.29289C11.6835 3.90237 12.3165 3.90237 12.707 4.29289L19.707 11.2929C20.0976 11.6834 20.0976 12.3164 19.707 12.707L12.707 19.707C12.3165 20.0975 11.6835 20.0975 11.293 19.707C10.9024 19.3164 10.9024 18.6834 11.293 18.2929L16.5859 12.9999H5C4.44772 12.9999 4 12.5522 4 11.9999C4 11.4476 4.44772 10.9999 5 10.9999H16.5859L11.293 5.70696C10.9024 5.31643 10.9024 4.68342 11.293 4.29289Z" fill="#36C3DC"/>
            </svg>
          </button>
          <h4 class="section-heading hidden lg:block">{{ contactHeading|e }}</h4>
          <div class="offices-wrapper lg-hidden" id="contact-content">
            <div class="offices">
              {% for office in offices %}
                <div class="office">
                  {% if office.title %}<h5>{{ office.title|e }}</h5>{% endif %}
                  {% if office.address %}<p>{{ office.address|nl2br }}</p>{% endif %}
                  {% if office.phone or office.phoneLink %}
                    <p>{{ telLabel|e }} {% if office.phoneLink %}{% set _tel = office.phoneLink %}{% set _href = (_tel|slice(0, 4) == 'tel:') ? _tel : 'tel:' ~ _tel|replace({' ': '', '-': '', '(': '', ')': ''}) %}<a href="{{ _href|e('esc_url') }}">{{ office.phone|default(office.phoneLink)|e }}</a>{% else %}{{ office.phone|e }}{% endif %}</p>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </div>
          <div class="offices-wrapper hidden lg:block" id="contact-content-desktop">
            <div class="offices">
              {% for office in offices|slice(0, 2) %}
                <div class="office">
                  {% if office.title %}<h5>{{ office.title|e }}</h5>{% endif %}
                  {% if office.address %}<p>{{ office.address|nl2br }}</p>{% endif %}
                  {% if office.phone or office.phoneLink %}
                    <p>{{ telLabel|e }} {% if office.phoneLink %}{% set _tel = office.phoneLink %}{% set _href = (_tel|slice(0, 4) == 'tel:') ? _tel : 'tel:' ~ _tel|replace({' ': '', '-': '', '(': '', ')': ''}) %}<a href="{{ _href|e('esc_url') }}">{{ office.phone|default(office.phoneLink)|e }}</a>{% else %}{{ office.phone|e }}{% endif %}</p>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
            <div class="offices">
              {% for office in offices|slice(2, 2) %}
                <div class="office">
                  {% if office.title %}<h5>{{ office.title|e }}</h5>{% endif %}
                  {% if office.address %}<p>{{ office.address|nl2br }}</p>{% endif %}
                  {% if office.phone or office.phoneLink %}
                    <p>{{ telLabel|e }} {% if office.phoneLink %}{% set _tel = office.phoneLink %}{% set _href = (_tel|slice(0, 4) == 'tel:') ? _tel : 'tel:' ~ _tel|replace({' ': '', '-': '', '(': '', ')': ''}) %}<a href="{{ _href|e('esc_url') }}">{{ office.phone|default(office.phoneLink)|e }}</a>{% else %}{{ office.phone|e }}{% endif %}</p>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
            <div class="offices">
              {% for office in offices|slice(4) %}
                <div class="office">
                  {% if office.title %}<h5>{{ office.title|e }}</h5>{% endif %}
                  {% if office.address %}<p>{{ office.address|nl2br }}</p>{% endif %}
                  {% if office.phone or office.phoneLink %}
                    <p>{{ telLabel|e }} {% if office.phoneLink %}{% set _tel = office.phoneLink %}{% set _href = (_tel|slice(0, 4) == 'tel:') ? _tel : 'tel:' ~ _tel|replace({' ': '', '-': '', '(': '', ')': ''}) %}<a href="{{ _href|e('esc_url') }}">{{ office.phone|default(office.phoneLink)|e }}</a>{% else %}{{ office.phone|e }}{% endif %}</p>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
        <div class="sitemap lg:hidden">
          <button class="accordion-toggle xl:hidden" aria-expanded="false" aria-controls="sitemap-content">
            <h4 class="section-heading">{{ siteMapHeading|e }}</h4>
            <svg xmlns="http://www.w3.org/2000/svg" class="accordion-icon" viewBox="0 0 24 24" fill="none">
              <path d="M11.293 4.29289C11.6835 3.90237 12.3165 3.90237 12.707 4.29289L19.707 11.2929C20.0976 11.6834 20.0976 12.3164 19.707 12.707L12.707 19.707C12.3165 20.0975 11.6835 20.0975 11.293 19.707C10.9024 19.3164 10.9024 18.6834 11.293 18.2929L16.5859 12.9999H5C4.44772 12.9999 4 12.5522 4 11.9999C4 11.4476 4.44772 10.9999 5 10.9999H16.5859L11.293 5.70696C10.9024 5.31643 10.9024 4.68342 11.293 4.29289Z" fill="#36C3DC"/>
            </svg>
          </button>
          <h4 class="section-heading hidden lg:block">{{ siteMapHeading|e }}</h4>
          <div class="sitemap-links{% if sitemapUseTwoColumns|default(false) %} sitemap-links--two-cols{% endif %}" id="sitemap-content">
            {% if sitemapCol1|length %}
              <div class="sitemap-col">
                <ul>
                  {% for item in sitemapCol1 %}
                    {{ _self.render_sitemap_nav_item(item) }}
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
            {% if sitemapCol2|length %}
              <div class="sitemap-col">
                <ul>
                  {% for item in sitemapCol2 %}
                    {{ _self.render_sitemap_nav_item(item) }}
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
            {% if sitemapCol3|length %}
              <div class="sitemap-col">
                <ul>
                  {% for item in sitemapCol3 %}
                    {% set _item_class = (item.classes|default([])|join(' '))|trim %}
                    <li><a href="{{ item.link|e('esc_url') }}" class="{{ _item_class }}" {{ item.is_target_blank ? ' target="_blank" rel="noopener noreferrer"' }}>{{ item.title|e }}</a></li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
    <div class="sitemap hidden lg:block">
      <h4 class="section-heading hidden lg:block">{{ siteMapHeading|e }}</h4>
      <div class="sitemap-links{% if sitemapUseTwoColumns|default(false) %} sitemap-links--two-cols{% endif %}" id="sitemap-content-lg">
        {% if sitemapCol1|length %}
          <div class="sitemap-col">
            <ul>
              {% for item in sitemapCol1 %}
                {{ _self.render_sitemap_nav_item(item) }}
              {% endfor %}
            </ul>
          </div>
        {% endif %}
        {% if sitemapCol2|length %}
          <div class="sitemap-col">
            <ul>
              {% for item in sitemapCol2 %}
                {{ _self.render_sitemap_nav_item(item) }}
              {% endfor %}
            </ul>
          </div>
        {% endif %}
        {% if sitemapCol3|length %}
          <div class="sitemap-col">
            <ul>
              {% for item in sitemapCol3 %}
                {{ _self.render_sitemap_nav_item(item) }}
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </div>
    </div>
    <div class="bottom">
      <div class="wrapper">
        <div class="copyright">
          <p>{{ copyright|e }}</p>
          {% if policyMenu and policyMenu.items|length %}
            <nav class="legal-links" aria-label="{{ __('Legal', 'NscSoftware')|e }}">
              {% for item in policyMenu.items %}
                <a href="{{ item.link|e('esc_url') }}"{% if item.target %} target="{{ item.target|e('html_attr') }}" rel="noopener noreferrer"{% endif %}>{{ item.title|e }}</a>
              {% endfor %}
            </nav>
          {% endif %}
        </div>
        {% if socialLinks|length %}
          <div class="social">
            {% for social in socialLinks %}
              <a href="{{ social.url|e('esc_url') }}" class="social-icon {{ social.platform }}" aria-label="{{ social.ariaLabel|default(social.platform)|e }}" target="_blank" rel="noopener noreferrer">
                {% if social.platform == 'linkedin' %}
                  <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 12C9.82843 12 10.5 12.6716 10.5 13.5V31.5C10.5 32.3284 9.82843 33 9 33H3C2.17157 33 1.5 32.3284 1.5 31.5V13.5C1.5 12.6716 2.17157 12 3 12H9ZM31.5 21C31.5 19.0109 30.7093 17.1038 29.3027 15.6973C27.8962 14.2907 25.9891 13.5 24 13.5C22.0109 13.5 20.1038 14.2907 18.6973 15.6973C17.2907 17.1038 16.5 19.0109 16.5 21V30H19.5V21C19.5 19.8065 19.9744 18.6623 20.8184 17.8184C21.6623 16.9744 22.8065 16.5 24 16.5C25.1935 16.5 26.3377 16.9744 27.1816 17.8184C28.0256 18.6623 28.5 19.8065 28.5 21V30H31.5V21ZM4.5 30H7.5V15H4.5V30ZM7.5 6C7.5 5.17157 6.82843 4.5 6 4.5C5.17157 4.5 4.5 5.17157 4.5 6C4.5 6.82843 5.17157 7.5 6 7.5C6.82843 7.5 7.5 6.82843 7.5 6ZM34.5 31.5C34.5 32.3284 33.8284 33 33 33H27C26.1716 33 25.5 32.3284 25.5 31.5V21C25.5 20.6022 25.3419 20.2208 25.0605 19.9395C24.7792 19.6581 24.3978 19.5 24 19.5C23.6022 19.5 23.2208 19.6581 22.9395 19.9395C22.6581 20.2208 22.5 20.6022 22.5 21V31.5C22.5 32.3284 21.8284 33 21 33H15C14.1716 33 13.5 32.3284 13.5 31.5V21C13.5 18.2152 14.6056 15.5438 16.5747 13.5747C18.5438 11.6056 21.2152 10.5 24 10.5C26.7848 10.5 29.4562 11.6056 31.4253 13.5747C33.3944 15.5438 34.5 18.2152 34.5 21V31.5ZM10.5 6C10.5 8.48528 8.48528 10.5 6 10.5C3.51472 10.5 1.5 8.48528 1.5 6C1.5 3.51472 3.51472 1.5 6 1.5C8.48528 1.5 10.5 3.51472 10.5 6Z" fill="#36C3DC"/>
                  </svg>
                {% elseif social.platform == 'facebook' %}
                  <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M19.5 10.5C19.5 9.70435 19.8163 8.94151 20.3789 8.37891C20.9415 7.8163 21.7043 7.5 22.5 7.5H25.5V4.5H22.5C20.9087 4.5 19.383 5.13259 18.2578 6.25781C17.1326 7.38303 16.5 8.9087 16.5 10.5V15C16.5 15.8284 15.8284 16.5 15 16.5H12V19.5H15C15.8284 19.5 16.5 20.1716 16.5 21V31.5H19.5V21C19.5 20.1716 20.1716 19.5 21 19.5H24.3296L25.0796 16.5H21C20.1716 16.5 19.5 15.8284 19.5 15V10.5ZM22.5 13.5H27C27.4619 13.5 27.8979 13.7131 28.1821 14.0771C28.4663 14.4411 28.5665 14.9153 28.4546 15.3633L26.9546 21.3633C26.7877 22.031 26.1883 22.5 25.5 22.5H22.5V33C22.5 33.8284 21.8284 34.5 21 34.5H15C14.1716 34.5 13.5 33.8284 13.5 33V22.5H10.5C9.67157 22.5 9 21.8284 9 21V15C9 14.1716 9.67157 13.5 10.5 13.5H13.5V10.5C13.5 8.11305 14.4489 5.82455 16.1367 4.13672C17.8245 2.44889 20.1131 1.5 22.5 1.5H27C27.8284 1.5 28.5 2.17157 28.5 3V9C28.5 9.82843 27.8284 10.5 27 10.5H22.5V13.5Z" fill="#36C3DC"/>
                  </svg>
                {% endif %}
              </a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </footer>
</nsc-software-component>
