{% if not (options.hidden|default(0)) %}
<nsc-software-component name="NSCBlockCareerWeAreNsc">
  <section class="we-are-nsc">
    {% if theme.buildUri %}
      <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-1.webp" class="hidden xl:block gallery-image gallery-image-top-left" alt="" loading="lazy" />
      <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-2.webp" class="hidden xl:block gallery-image gallery-image-top-right" alt="" loading="lazy" />
      <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-6.webp" class="hidden xl:block gallery-image gallery-image-middle-right" alt="" loading="lazy" />
      <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-7.webp" class="hidden xl:block gallery-image gallery-image-bottom-right" alt="" loading="lazy" />
      <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-4.webp" class="hidden xl:block gallery-image gallery-image-center-bottom" alt="" loading="lazy" />
      <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-3.webp" class="hidden xl:block gallery-image gallery-image-middle-left" alt="" loading="lazy" />
      <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-5.webp" class="hidden xl:block gallery-image gallery-image-bottom-left" alt="" loading="lazy" />
    {% endif %}
    <div class="wrapper">
      <div class="col">
        {% if theme.buildUri %}
          <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-heading.webp" class="hidden xl:block gallery-image gallery-image-heading" alt="" loading="lazy" />
        {% endif %}
        <div class="heading">
          {% if headingIcon.url or headingIcon.src %}
            <img src="{{ (headingIcon.url|default(headingIcon.src))|e('esc_url') }}" alt="{{ (headingIcon.alt|default(''))|e }}" loading="lazy" />
          {% elseif theme.buildUri %}
            <img src="{{ theme.buildUri|e('esc_url') }}/img/heading-icon.webp" alt="" loading="lazy" />
          {% endif %}
          <h2>{{ heading|default('WE ARE NSC <br class="hidden xl:block"> SOFTWARE')|raw }}</h2>
        </div>
      </div>
      {% if theme.buildUri %}
        <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-group-1.webp" class="xl:hidden gallery-image-group" alt="" loading="lazy" />
      {% endif %}
      <div class="col right-col">
        {% if theme.buildUri %}
          <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-body-4.webp" class="hidden xl:block gallery-image gallery-image-content-top" alt="" loading="lazy" />
          <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-body-3.webp" class="hidden xl:block gallery-image gallery-image-content-image-top-right" alt="" loading="lazy" />
          <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-body-2.webp" class="hidden xl:block gallery-image gallery-image-content-bottom-right" alt="" loading="lazy" />
          <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-body-1.webp" class="hidden xl:block gallery-image gallery-image-content-bottom" alt="" loading="lazy" />
          <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-body-6.webp" class="hidden xl:block gallery-image gallery-image-content-bottom-left" alt="" loading="lazy" />
          <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-body-5.webp" class="hidden xl:block gallery-image gallery-image-content-top-left" alt="" loading="lazy" />
        {% endif %}
        <div>
          {{ body|default('')|raw }}
        </div>
        {% if ctaText %}
          <div class="block-link">
            <a href="{{ (ctaUrl|default('#open-positions-app'))|e('html_attr') }}">{{ ctaText|e }}
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M11.293 4.29289C11.6835 3.90237 12.3165 3.90237 12.707 4.29289L19.707 11.2929C20.0976 11.6834 20.0976 12.3164 19.707 12.707L12.707 19.707C12.3165 20.0975 11.6835 20.0975 11.293 19.707C10.9024 19.3164 10.9024 18.6834 11.293 18.2929L16.5859 12.9999H5C4.44772 12.9999 4 12.5522 4 11.9999C4 11.4476 4.44772 10.9999 5 10.9999H16.5859L11.293 5.70696C10.9024 5.31643 10.9024 4.68342 11.293 4.29289Z" fill="#36C3DC"></path>
              </svg>
            </a>
          </div>
        {% endif %}
      </div>
      {% if theme.buildUri %}
        <img src="{{ theme.buildUri|e('esc_url') }}/img/wansc-group-2.webp" class="xl:hidden gallery-image-group pt-6" alt="" loading="lazy" />
      {% endif %}
    </div>
  </section>
</nsc-software-component>
{% endif %}
