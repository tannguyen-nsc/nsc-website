{% if not (options.hidden|default(0)) %}
<nsc-software-component name="NSCBlockOurServices">
  {% set sectionBg = (backgroundImage.url|default(backgroundImage.src)) %}
  <section class="our-services" {% if sectionBg %}style="background-image: url('{{ sectionBg|e('esc_url') }}'); background-size: cover; background-position: center; background-repeat: no-repeat;"{% elseif theme.buildUri %}style="background-image: url('{{ theme.buildUri }}/img/our-services.webp'); background-size: cover; background-position: center; background-repeat: no-repeat;"{% endif %}>
  <div class="wrapper">
    <div class="heading">
      {% if headingIcon.url or headingIcon.src %}
        <img src="{{ (headingIcon.url|default(headingIcon.src))|e('esc_url') }}" alt="{{ (headingIcon.alt|default(''))|e }}" loading="lazy" />
      {% elseif theme.buildUri %}
        <img src="{{ theme.buildUri }}/img/heading-icon.webp" alt="Heading Icon" loading="lazy" />
      {% endif %}
      <h2>{{ title|e }}</h2>
    </div>
    <div class="services">
      <div class="service">
        <div class="description">
          {% if introDescription %}<p>{{ introDescription|e }}</p>{% endif %}
        </div>
        {% if introButton.label and introButton.url %}
          <div class="buttons">
            <a href="{{ introButton.url|e('esc_url') }}" class="btn" {{ introButton.openInNewTab ? ' target="_blank" rel="noopener noreferrer"' }}>
              {{ introButton.label|e }}
              <svg class="right" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8.29289 5.29289C8.68342 4.90237 9.31643 4.90237 9.70696 5.29289L15.707 11.2929C16.0975 11.6834 16.0975 12.3164 15.707 12.707L9.70696 18.707C9.31643 19.0975 8.68342 19.0975 8.29289 18.707C7.90237 18.3164 7.90237 17.6834 8.29289 17.2929L13.5859 11.9999L8.29289 6.70696C7.90237 6.31643 7.90237 5.68342 8.29289 5.29289Z" fill="#36C3DC"/>
              </svg>
              <svg class="down" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M11.5292 5.52876C11.7896 5.26841 12.2116 5.26841 12.472 5.52876C12.7323 5.78911 12.7323 6.21112 12.472 6.47147L8.47196 10.4715C8.21161 10.7318 7.7896 10.7318 7.52925 10.4715L3.52925 6.47147C3.2689 6.21112 3.2689 5.78911 3.52925 5.52876C3.7896 5.26841 4.21161 5.26841 4.47195 5.52876L8.0006 9.0574L11.5292 5.52876Z" fill="#36C3DC"/>
              </svg>
            </a>
          </div>
        {% endif %}
      </div>
      {% for service in services %}
        <div class="service">
          <div class="header">
            <span>{{ service.number|default('%02d'|format(loop.index)) }}</span>
            <svg class="plus" width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12.8327 22.1665V15.1665H5.83268C5.18835 15.1665 4.66602 14.6442 4.66602 13.9998C4.66602 13.3555 5.18835 12.8332 5.83268 12.8332H12.8327V5.83317C12.8327 5.18884 13.355 4.6665 13.9993 4.6665C14.6437 4.6665 15.166 5.18884 15.166 5.83317V12.8332H22.166C22.8103 12.8332 23.3327 13.3555 23.3327 13.9998C23.3327 14.6442 22.8103 15.1665 22.166 15.1665H15.166V22.1665C15.166 22.8108 14.6437 23.3332 13.9993 23.3332C13.355 23.3332 12.8327 22.8108 12.8327 22.1665Z" fill="#0A0A0A"/>
            </svg>
            <svg class="minus" width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.166 12.8335C22.8103 12.8335 23.3327 13.3558 23.3327 14.0002C23.3327 14.6445 22.8103 15.1668 22.166 15.1668H5.83268C5.18835 15.1668 4.66602 14.6445 4.66602 14.0002C4.66602 13.3558 5.18835 12.8335 5.83268 12.8335H22.166Z" fill="#F9F9FB"/>
            </svg>
          </div>
          <h2><span>{{ service.number|default('%02d'|format(loop.index)) }}. </span>{{ service.title|e }}</h2>
          <div class="description">
            {% if service.description %}<p>{{ service.description|e }}</p>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="bottom-sheet-overlay" id="bottomSheetOverlay"></div>
  <div class="bottom-sheet" id="bottomSheet">
    <div class="bottom-sheet-header">
      <h3 class="bottom-sheet-title" id="bottomSheetTitle"></h3>
      <button class="bottom-sheet-close" id="bottomSheetClose" aria-label="{{ __('Close', 'NscSoftware')|e }}">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M21 7L7 21M7 7L21 21" stroke="#F9F9FB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    <div class="bottom-sheet-content">
      <div class="service-content" id="bottomSheetContent"></div>
    </div>
  </div>
  </section>
</nsc-software-component>
{% endif %}
