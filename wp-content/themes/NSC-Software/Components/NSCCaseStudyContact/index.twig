{% if not (options.hidden|default(0)) %}
<nsc-software-component name="NSCCaseStudyContact">
  {% set sectionBg = (backgroundImage.url|default(backgroundImage.src)) %}
  <section class="contact-us" {% if sectionBg %}style="background-image: url('{{ sectionBg|e('esc_url') }}'); background-size: cover; background-position: center; background-repeat: no-repeat;"{% elseif theme.buildUri %}style="background-image: url('{{ theme.buildUri }}/img/join-bg.png'); background-size: cover; background-position: center; background-repeat: no-repeat;"{% endif %}>
  <div class="wrapper">
    <div class="col">
      <div class="heading">
        {% if headingIcon.url or headingIcon.src %}
          <img src="{{ (headingIcon.url|default(headingIcon.src))|e('esc_url') }}" alt="{{ (headingIcon.alt|default(''))|e }}" loading="lazy" />
        {% elseif theme.buildUri %}
          <img src="{{ theme.buildUri }}/img/heading-icon.png" alt="Heading Icon" loading="lazy" />
        {% endif %}
        <h2>{{ title|e }}</h2>
      </div>
      <div class="content">
        {% if contentLines %}
          {% for line in contentLines|split("\n") %}
            {% if line|trim %}<p>{{ line|trim|e }}</p>{% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </div>
    <div class="col">
      {% if showForm and cf7Shortcode|trim %}
        <div class="form">
          {{ function('do_shortcode', cf7Shortcode|trim)|raw }}
        </div>
      {% endif %}
    </div>
  </div>
  </section>
</nsc-software-component>
{% endif %}
